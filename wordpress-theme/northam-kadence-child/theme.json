{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "hsl(175, 65%, 40%)",
          "name": "Primary (Teal)"
        },
        {
          "slug": "primary-dark",
          "color": "hsl(175, 65%, 30%)",
          "name": "Primary Dark"
        },
        {
          "slug": "accent",
          "color": "hsl(15, 80%, 55%)",
          "name": "Accent (Orange)"
        },
        {
          "slug": "accent-dark",
          "color": "hsl(15, 80%, 45%)",
          "name": "Accent Dark"
        },
        {
          "slug": "background",
          "color": "hsl(50, 30%, 97%)",
          "name": "Background (Cream)"
        },
        {
          "slug": "foreground",
          "color": "hsl(200, 30%, 15%)",
          "name": "Foreground (Dark Blue-Gray)"
        },
        {
          "slug": "muted",
          "color": "hsl(50, 20%, 90%)",
          "name": "Muted"
        },
        {
          "slug": "muted-foreground",
          "color": "hsl(200, 15%, 45%)",
          "name": "Muted Foreground"
        },
        {
          "slug": "card",
          "color": "hsl(0, 0%, 100%)",
          "name": "Card (White)"
        },
        {
          "slug": "border",
          "color": "hsl(50, 25%, 85%)",
          "name": "Border"
        },
        {
          "slug": "coastal-deep",
          "color": "hsl(180, 55%, 30%)",
          "name": "Coastal Deep"
        },
        {
          "slug": "coastal-mid",
          "color": "hsl(175, 55%, 45%)",
          "name": "Coastal Mid"
        },
        {
          "slug": "coastal-light",
          "color": "hsl(170, 50%, 70%)",
          "name": "Coastal Light"
        },
        {
          "slug": "sand-warm",
          "color": "hsl(45, 55%, 80%)",
          "name": "Sand Warm"
        },
        {
          "slug": "sand-light",
          "color": "hsl(50, 40%, 93%)",
          "name": "Sand Light"
        },
        {
          "slug": "sea-foam",
          "color": "hsl(170, 40%, 82%)",
          "name": "Sea Foam"
        },
        {
          "slug": "event-venue",
          "color": "hsl(175, 55%, 38%)",
          "name": "Event: Venue"
        },
        {
          "slug": "event-business",
          "color": "hsl(50, 70%, 45%)",
          "name": "Event: Business"
        },
        {
          "slug": "event-community",
          "color": "hsl(15, 80%, 55%)",
          "name": "Event: Community"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        }
      ],
      "gradients": [
        {
          "slug": "coastal",
          "gradient": "linear-gradient(135deg, hsl(180, 55%, 30%) 0%, hsl(175, 55%, 45%) 50%, hsl(170, 50%, 70%) 100%)",
          "name": "Coastal"
        },
        {
          "slug": "sand",
          "gradient": "linear-gradient(180deg, hsl(50, 40%, 93%) 0%, hsl(45, 55%, 80%) 100%)",
          "name": "Sand"
        },
        {
          "slug": "hero-overlay",
          "gradient": "linear-gradient(to bottom, hsla(180, 55%, 30%, 0.8) 0%, hsla(175, 55%, 45%, 0.4) 50%, hsla(180, 55%, 30%, 0.9) 100%)",
          "name": "Hero Overlay"
        },
        {
          "slug": "primary-to-accent",
          "gradient": "linear-gradient(135deg, hsl(175, 65%, 40%) 0%, hsl(15, 80%, 55%) 100%)",
          "name": "Primary to Accent"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
          "slug": "heading",
          "name": "Heading (Cormorant Garamond)"
        },
        {
          "fontFamily": "'Source Sans 3', 'Source Sans Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "body",
          "name": "Body (Source Sans 3)"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "clamp(0.875rem, 0.8rem + 0.375vw, 1rem)",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "clamp(1rem, 0.9rem + 0.5vw, 1.125rem)",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1.125rem, 1rem + 0.625vw, 1.25rem)",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "clamp(1.5rem, 1.25rem + 1.25vw, 2rem)",
          "name": "2X Large"
        },
        {
          "slug": "huge",
          "size": "clamp(2.25rem, 1.75rem + 2.5vw, 3rem)",
          "name": "Huge"
        },
        {
          "slug": "gigantic",
          "size": "clamp(3rem, 2rem + 5vw, 4.5rem)",
          "name": "Gigantic"
        }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem", "name": "1" },
        { "slug": "20", "size": "0.5rem", "name": "2" },
        { "slug": "30", "size": "0.75rem", "name": "3" },
        { "slug": "40", "size": "1rem", "name": "4" },
        { "slug": "50", "size": "1.5rem", "name": "5" },
        { "slug": "60", "size": "2rem", "name": "6" },
        { "slug": "70", "size": "3rem", "name": "7" },
        { "slug": "80", "size": "4rem", "name": "8" },
        { "slug": "90", "size": "6rem", "name": "9" }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--gigantic)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--huge)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "blank", "title": "Blank", "postTypes": ["page", "post"] },
    { "name": "full-width", "title": "Full Width", "postTypes": ["page"] }
  ]
}
